global:
  resolve_timeout: 5m

route:
  receiver: ${receiver_name}
  group_by: ["alertname", "job"]
  group_wait: 15s
  group_interval: 1m
  repeat_interval: 4h

receivers:
  - name: local
%{ if discord_webhook_url != "" ~}
  - name: discord
    discord_configs:
      - webhook_url: ${jsonencode(discord_webhook_url)}
        send_resolved: true
        title: '{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}'
        message: '{{ range .Alerts }}{{ .Annotations.summary }}{{ "\n" }}{{ .Annotations.description }}{{ end }}'
%{ endif ~}
