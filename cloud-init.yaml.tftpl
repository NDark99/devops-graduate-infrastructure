#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - curl
  - ufw

write_files:
  - path: /opt/devops/compose.yaml
    permissions: "0644"
    encoding: b64
    content: ${compose_b64}
  - path: /opt/devops/prometheus/prometheus.yml
    permissions: "0644"
    encoding: b64
    content: ${prometheus_b64}
  - path: /opt/devops/loki/loki.yml
    permissions: "0644"
    encoding: b64
    content: ${loki_b64}
  - path: /opt/devops/promtail/promtail.yml
    permissions: "0644"
    encoding: b64
    content: ${promtail_b64}
  - path: /opt/devops/grafana/provisioning/datasources/datasources.yml
    permissions: "0644"
    encoding: b64
    content: ${datasource_b64}
  - path: /opt/devops/grafana/provisioning/dashboards/provider.yml
    permissions: "0644"
    encoding: b64
    content: ${dashboard_provider_b64}
  - path: /opt/devops/grafana/dashboards/devops-overview.json
    permissions: "0644"
    encoding: b64
    content: ${dashboard_b64}
  - path: /opt/devops/.env
    permissions: "0600"
    content: |
      APP_IMAGE=${application_image}
      GRAFANA_ADMIN_PASSWORD=${grafana_admin_password}

runcmd:
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow OpenSSH
  - ufw allow 80/tcp
  - ufw allow from ${admin_cidr} to any port 3000 proto tcp
  - ufw allow from ${admin_cidr} to any port 9090 proto tcp
  - ufw --force enable
  - cd /opt/devops && docker compose up -d prometheus grafana loki promtail node-exporter cadvisor

final_message: "DevOps server bootstrap completed after $UPTIME seconds."
